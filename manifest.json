{
  "manifest_version": 3,
  "name": "webbuddy",
  "version": "1.4.1",
  "description": "A browsing assistant in your sidebar: ask about selected text, explain the current page, hide or shrink images and video, block ads, and dock tabs with the built-in Tab Dock manager (100% local). Works with any OpenAI-compatible API (DeepSeek / Moonshot / Qwen / Ollama…).",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "sidePanel", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "side_panel": { "default_path": "sidepanel/index.html" },
  "options_page": "options/options.html",
  "action": {
    "default_title": "webbuddy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
