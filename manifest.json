{
  "manifest_version": 3,
  "name": "学习助手",
  "version": "1.3.0",
  "description": "一站式浏览助手：选中文字右键提问、解读当前页面、图片/视频一键隐藏或缩略，并内置 OneTab 标签收纳管理页（完全本地）。支持 OpenAI 兼容 API（DeepSeek / Moonshot / 通义 / Ollama…）。",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "sidePanel", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "side_panel": { "default_path": "sidepanel/index.html" },
  "options_page": "options/options.html",
  "action": {
    "default_title": "学习助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
